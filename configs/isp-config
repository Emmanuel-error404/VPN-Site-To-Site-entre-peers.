! Equipo: ISP (Cisco IOS)
! Proposito: direccionamiento publico hacia R2 y hacia el FortiGate
enable
configure terminal
hostname ISP
interface f0/0
 description HACIA-R2
 ip address 20.25.7.1 255.255.255.252
 no shutdown
interface g1/0
 description HACIA-FORTIGATE
 ip address 20.25.98.1 255.255.255.252
 no shutdown
end
write memory
